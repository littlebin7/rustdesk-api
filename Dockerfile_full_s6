# 直接继承 alonginwind 的成品 s6 镜像（不再"挑文件重组"）
#
# 底座已经包含：
#   - hbbs / hbbr / rustdesk-utils 1.1.17（含 MUST_LOGIN 等 server fork 特性）
#   - s6-overlay 启动框架 + hbbs / hbbr / api / key-secret 等服务定义（api 服务就是 cd /app && ./apimain）
#   - /ip2region_v4.xdb（多中继按运营商选择用，单中继时不生效）
#   - tzdata、HEALTHCHECK、VOLUME /data、VOLUME /app/data、EXPOSE、ENTRYPOINT ["/init"]
#
# 我们只做一件事：用自己 CI 编译的 release/ 覆盖 /app（apimain + resources + conf + docs）
FROM alonginwind/rustdesk-server-s6:v1.2.4

ARG BUILDARCH

COPY ./${BUILDARCH}/release /app/

WORKDIR /app

# 回退方式（二选一）：
#   git revert <本次提交>
